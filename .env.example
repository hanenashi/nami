# Optional Compose settings. No secrets are needed for M0.
# Create this directory before starting. It must be outside the checkout.
NAMI_DATA_DIR=../nami-data
NAMI_PORT=3000
# Match the owner of NAMI_DATA_DIR (run id -u and id -g).
NAMI_UID=1000
NAMI_GID=1000
# Keep false for the default local HTTP address. HTTPS deployments must use true.
NAMI_SECURE_COOKIES=false
# Optional HTTPS reverse proxy: comma-separated exact proxy IPs/CIDRs.
# Set only after verifying that proxy replaces untrusted forwarded headers.
# Leave unset for direct/local traffic; never use a broad wildcard.
# NAMI_TRUSTED_PROXIES=127.0.0.1
